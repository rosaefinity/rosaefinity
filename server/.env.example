# RosaeFinity Server - Production Environment Variables
# Copy this file to .env and fill in your values
#
# IMPORTANT: This file is for the Express API server
# DO NOT commit this file with real values to version control

# Server Configuration
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Database (MySQL)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://YOUR_USER:YOUR_PASSWORD@YOUR_HOST:3306/rosaefinity

# JWT Configuration (minimum 32 characters)
# Generate a strong random string for production
JWT_SECRET=YOUR_MINIMUM_32_CHARACTER_SECRET_HERE
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS (comma-separated list of allowed origins)
# Must include your frontend and admin dashboard URLs
# Example: https://rosaefinity.com,https://admin.rosaefinity.com
CORS_ORIGINS=YOUR_PRODUCTION_FRONTEND_URL,YOUR_PRODUCTION_ADMIN_URL

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
