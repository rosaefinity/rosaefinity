generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String         @id @default(uuid())
  email            String?        @unique
  passwordHash     String?
  displayName      String?
  avatarUrl        String?
  authProvider     String         @default("email")
  providerId       String?
  accountType      String         @default("free")
  isAnonymous      Boolean        @default(false)
  emailVerified    Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  role             String         @default("USER")
  apiKeys          ApiKey[]
  auditLogs        AuditLog[]
  devices          Device[]
  licenses         License[]
  notifications    Notification[]
  approvedPayments Payment[]      @relation("ApprovedPayments")
  payments         Payment[]      @relation("UserPayments")
  sessions         Session[]
  subscriptions    Subscription[]
  syncRecords      SyncRecord[]

  @@index([email])
  @@index([authProvider, providerId])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  accessToken  String   @unique
  refreshToken String   @unique
  deviceId     String?
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accessToken])
  @@index([refreshToken])
}

model Device {
  id                 String   @id @default(uuid())
  userId             String
  deviceId           String   @unique
  name               String
  platform           String
  appVersion         String?
  machineFingerprint String?
  status             String   @default("active")
  lastSeenAt         DateTime @default(now())
  activatedAt        DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
  @@index([status])
}

model Plan {
  id                String         @id
  name              String
  description       String?
  features          String[]
  maxActions        Int            @default(0)
  maxSounds         Int            @default(0)
  maxOverlays       Int            @default(0)
  maxProfiles       Int            @default(0)
  maxScreens        Int            @default(1)
  maxPointsUsers    Int            @default(0)
  maxDevices        Int            @default(1)
  isTrialAvailable  Boolean        @default(false)
  trialDurationDays Int            @default(0)
  sortOrder         Int            @default(0)
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  licenses          License[]
  payments          Payment[]
  subscriptions     Subscription[]
}

model License {
  id                String    @id @default(uuid())
  userId            String
  planId            String
  licenseKey        String?   @unique
  status            String    @default("inactive")
  activatedAt       DateTime  @default(now())
  expiresAt         DateTime?
  trialStartedAt    DateTime?
  trialEndedAt      DateTime?
  gracePeriodEndsAt DateTime?
  lastValidatedAt   DateTime?
  email             String?
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  plan              Plan      @relation(fields: [planId], references: [id])
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([licenseKey])
  @@index([status])
}

model Subscription {
  id                 String    @id @default(uuid())
  userId             String
  planId             String
  status             String    @default("inactive")
  provider           String
  providerId         String?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  plan               Plan      @relation(fields: [planId], references: [id])
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([provider, providerId])
}

model Payment {
  id              String    @id @default(uuid())
  userId          String
  planId          String    @default("free")
  amount          Int
  paymentMethod   String    @default("qris")
  status          String    @default("PENDING")
  paymentProofUrl String?
  adminNotes      String?
  approvedById    String?
  approvedAt      DateTime?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  approvedBy      User?     @relation("ApprovedPayments", fields: [approvedById], references: [id])
  plan            Plan      @relation(fields: [planId], references: [id])
  user            User      @relation("UserPayments", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model SyncRecord {
  id            String   @id @default(uuid())
  userId        String
  entityType    String
  entityId      String
  data          Json
  version       Int      @default(1)
  checksum      String
  serverVersion Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@index([userId, entityType])
  @@index([updatedAt])
}

model UpdateHistory {
  id          String   @id @default(uuid())
  userId      String?
  fromVersion String
  toVersion   String
  channel     String   @default("stable")
  status      String
  platform    String?
  appVersion  String?
  installedAt DateTime @default(now())
  metadata    Json?

  @@index([toVersion])
  @@index([installedAt])
}

model AnalyticsEvent {
  id         String   @id @default(uuid())
  userId     String?
  eventType  String
  eventData  Json
  appVersion String?
  platform   String?
  sessionId  String?
  createdAt  DateTime @default(now())

  @@index([eventType])
  @@index([createdAt])
  @@index([userId])
}

model Plugin {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String
  description String?
  author      String?
  version     String
  manifest    Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ApiKey {
  id         String    @id @default(uuid())
  userId     String
  name       String
  keyHash    String    @unique
  keyPrefix  String
  scopes     String[]
  expiresAt  DateTime?
  lastUsedAt DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyHash])
}

model RefreshToken {
  id                String   @id @default(uuid())
  token             String   @unique
  userId            String
  sessionId         String?
  deviceFingerprint String?
  expiresAt         DateTime
  isRevoked         Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@index([token])
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  actionUrl String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}
