// =============================================
// RosaeFinity Server — Prisma Schema
// PostgreSQL database models for all modules.
// =============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Users ──
model User {
  id            String    @id @default(uuid())
  email         String?   @unique
  passwordHash  String?   // bcrypt hashed password (null for OAuth/anonymous users)
  displayName   String?
  avatarUrl     String?
  authProvider  String    @default("email") // email | google | github | discord | microsoft | anonymous
  providerId    String?   // OAuth provider user ID
  accountType   String    @default("free") // guest | free | pro | enterprise
  isAnonymous   Boolean   @default(false)
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  sessions      Session[]
  devices       Device[]
  licenses      License[]
  subscriptions Subscription[]
  syncRecords   SyncRecord[]
  apiKeys       ApiKey[]
  auditLogs     AuditLog[]
  notifications Notification[]

  @@index([email])
  @@index([authProvider, providerId])
}

// ── Sessions ──
model Session {
  id           String   @id @default(uuid())
  userId       String
  accessToken  String   @unique
  refreshToken String   @unique
  deviceId     String?
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accessToken])
  @@index([refreshToken])
}

// ── Devices ──
model Device {
  id              String   @id @default(uuid())
  userId          String
  deviceId        String   @unique // Client-generated device ID
  name            String
  platform        String
  appVersion      String?
  machineFingerprint String?
  status          String   @default("active") // active | inactive | revoked
  lastSeenAt      DateTime @default(now())
  activatedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
  @@index([status])
}

// ── Plans ──
model Plan {
  id              String   @id // guest | free | pro | enterprise
  name            String
  description     String?
  features        String[] // Feature flags
  maxActions      Int      @default(0)
  maxSounds       Int      @default(0)
  maxOverlays     Int      @default(0)
  maxProfiles     Int      @default(0)
  maxScreens      Int      @default(1)
  maxPointsUsers  Int      @default(0)
  maxDevices      Int      @default(1)
  isTrialAvailable Boolean @default(false)
  trialDurationDays Int    @default(0)
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  licenses        License[]
  subscriptions   Subscription[]
}

// ── Licenses ──
model License {
  id              String   @id @default(uuid())
  userId          String
  planId          String
  licenseKey      String?  @unique
  status          String   @default("inactive") // active | expired | revoked | grace | inactive
  activatedAt     DateTime @default(now())
  expiresAt       DateTime?
  trialStartedAt  DateTime?
  trialEndedAt    DateTime?
  gracePeriodEndsAt DateTime?
  lastValidatedAt DateTime?
  email           String?
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            Plan     @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([licenseKey])
  @@index([status])
}

// ── Subscriptions ──
model Subscription {
  id              String   @id @default(uuid())
  userId          String
  planId          String
  status          String   @default("active") // active | cancelled | expired | past_due
  provider        String   // stripe | paypal | lemon_squeezy | mock
  providerId      String?  // External subscription ID
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            Plan     @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([provider, providerId])
}

// ── Sync Records ──
model SyncRecord {
  id           String   @id @default(uuid())
  userId       String
  entityType   String   // action | sound | overlay | settings | alert | goal | preference
  entityId     String
  data         Json
  version      Int      @default(1)
  checksum     String
  serverVersion Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@index([userId, entityType])
  @@index([updatedAt])
}

// ── Update History ──
model UpdateHistory {
  id            String   @id @default(uuid())
  userId        String?
  fromVersion   String
  toVersion     String
  channel       String   @default("stable")
  status        String   // downloaded | installed | failed | rolled_back
  platform      String?
  appVersion    String?
  installedAt   DateTime @default(now())
  metadata      Json?

  @@index([toVersion])
  @@index([installedAt])
}

// ── Analytics Events ──
model AnalyticsEvent {
  id            String   @id @default(uuid())
  userId        String?
  eventType     String   // app_start | feature_usage | crash_report | performance_metric
  eventData     Json
  appVersion    String?
  platform      String?
  sessionId     String?
  createdAt     DateTime @default(now())

  @@index([eventType])
  @@index([createdAt])
  @@index([userId])
}

// ── Plugins ──
model Plugin {
  id            String   @id @default(uuid())
  name          String   @unique
  displayName   String
  description   String?
  author        String?
  version       String
  manifest      Json
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ── API Keys ──
model ApiKey {
  id            String   @id @default(uuid())
  userId        String
  name          String
  keyHash       String   @unique
  keyPrefix     String   // First 8 chars for display
  scopes        String[]
  expiresAt     DateTime?
  lastUsedAt    DateTime?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyHash])
}

// ── Refresh Tokens ──
model RefreshToken {
  id            String   @id @default(uuid())
  token         String   @unique
  userId        String
  sessionId     String?
  deviceFingerprint String?
  expiresAt     DateTime
  isRevoked     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([token])
  @@index([userId])
}

// ── Audit Logs ──
model AuditLog {
  id            String   @id @default(uuid())
  userId        String?
  action        String
  resource      String
  resourceId    String?
  details       Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ── Notifications ──
model Notification {
  id            String   @id @default(uuid())
  userId        String
  type          String   // info | warning | error | update | license
  title         String
  message       String
  isRead        Boolean  @default(false)
  actionUrl     String?
  metadata      Json?
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}
