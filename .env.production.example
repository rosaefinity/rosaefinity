# RosaeFinity Frontend - PRODUCTION
# This file is used during `npm run build` (Vite production build)
# Copy to .env.production and set your actual values

# Production API URL (Railway backend)
# Example: VITE_API_URL=https://rosaefinity-backend.up.railway.app/api
VITE_API_URL=YOUR_BACKEND_API_URL

# Production Admin URL (if applicable)
VITE_ADMIN_URL=YOUR_ADMIN_URL
